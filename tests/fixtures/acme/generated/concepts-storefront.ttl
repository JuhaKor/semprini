c:b7602300-4bbd-11f1-9a8b-0242ac120002 a sem:Attribute ;
  skos:prefLabel "Line price"@en ;
  dcterms:modified "2026-08-06"^^xsd:date ;
  skos:inScheme sch:storefront ;
  sem:attributeOf c:bc2c3f24-f991-43f0-8283-5d7753485213 ;
  sem:sourceRef "ellie-main:b7602300-4bbd-11f1-9a8b-0242ac120002" ;
  sem:status "active" .

c:b7602404-4bbd-11f1-9a8b-0242ac120002 a sem:Attribute ;
  skos:prefLabel "Product ID"@en ;
  dcterms:modified "2026-08-06"^^xsd:date ;
  skos:inScheme sch:storefront ;
  sem:attributeOf c:bc2c3f24-f991-43f0-8283-5d7753485213 ;
  sem:sourceRef "ellie-main:b7602404-4bbd-11f1-9a8b-0242ac120002" ;
  sem:status "active" .

c:bc2c3f24-f991-43f0-8283-5d7753485213 a sem:Entity ;
  skos:prefLabel "Order line"@en ;
  dcterms:modified "2026-08-06"^^xsd:date ;
  skos:altLabel "Line item"@en ;
  skos:altLabel "Order detail"@en ;
  skos:altLabel "Order item"@en ;
  skos:definition "An order line represents a single product entry within an order, capturing which product is being purchased, how many units, and at what price."@en ;
  skos:inScheme sch:storefront ;
  sem:sourceRef "ellie-main:bc2c3f24-f991-43f0-8283-5d7753485213" ;
  sem:status "active" .

c:e1881e8c-aa23-11ee-9f34-0242ac1e0003 a sem:Entity ;
  skos:prefLabel "Product"@en ;
  dcterms:modified "2026-08-06"^^xsd:date ;
  skos:altLabel "Article"@en ;
  skos:altLabel "Item"@en ;
  skos:altLabel "Offering"@en ;
  skos:altLabel "SKU"@en ;
  skos:definition "A product is anything our organization sells: either physical products or services such as consulting."@en ;
  skos:inScheme sch:storefront ;
  sem:sourceRef "ellie-main:e1881e8c-aa23-11ee-9f34-0242ac1e0003" ;
  sem:status "active" .

